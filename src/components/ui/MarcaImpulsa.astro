---
// Marca Impulsa
// ------------
// Description: El bloque de marca (isotipo + logotipo) de Cooperativa Impulsa.
//
// Usa los archivos oficiales del manual de identidad (1.1.1 y 1.1.2), en
// `public/marca/`. El logotipo es imagen porque sus tipografias (Rouben y
// Gemanticus) no existen como fuente web; el nombre accesible lo da el
// `aria-label` del contenedor.
//
// En modo oscuro el isotipo se mantiene a color y el nombre pasa a blanco
// (manual 1.2.2).
//
// Properties:
// - tamano: escala del bloque de marca (sm, base, lg, xl)
// - soloIsotipo: oculta el logotipo y deja unicamente el simbolo
// - enlace: URL destino; si es null no se envuelve en <a>

type Props = {
	tamano?: 'sm' | 'base' | 'lg' | 'xl'
	soloIsotipo?: boolean
	enlace?: string | null
	classes?: string
}
const { tamano = 'base', soloIsotipo = false, enlace = '/', classes } = Astro.props

const medidas = {
	sm: { isotipo: 'h-9', logotipo: 'h-6' },
	base: { isotipo: 'h-11', logotipo: 'h-7' },
	lg: { isotipo: 'h-16', logotipo: 'h-10' },
	// Solo para la portada, donde la marca encabeza el bloque en lugar de
	// acompañarlo. Fuera de ahí compite con el titular.
	xl: { isotipo: 'h-20 sm:h-24', logotipo: 'h-11 sm:h-14' }
}[tamano]

const Contenedor = enlace ? 'a' : 'div'
---

<Contenedor
	{...enlace ? { href: enlace } : { role: 'img' }}
	class:list={['marca', { [`${classes}`]: classes }]}
	aria-label="Cooperativa Impulsa"
>
	<img
		src="/marca/isotipo.webp"
		alt=""
		width="360"
		height="323"
		decoding="async"
		class:list={['marca__isotipo', medidas.isotipo]}
	/>
	{
		!soloIsotipo && (
			<span class="marca__logotipo">
				<img
					src="/marca/logotipo-negro.webp"
					alt=""
					width="640"
					height="124"
					decoding="async"
					class:list={['dark:hidden', medidas.logotipo]}
				/>
				<img
					src="/marca/logotipo-blanco.webp"
					alt=""
					width="640"
					height="124"
					decoding="async"
					class:list={['hidden dark:block', medidas.logotipo]}
				/>
			</span>
		)
	}
</Contenedor>

<style>
	@reference '../../styles/global.css';
	.marca {
		@apply inline-flex items-center gap-2 no-underline;
	}
	.marca img {
		@apply w-auto max-w-none;
	}
	.marca__isotipo {
		@apply shrink-0;
	}
	.marca__logotipo {
		/* En el manual el nombre se alinea por debajo del centro del isotipo. */
		@apply flex shrink-0 translate-y-[12%] items-center;
	}
</style>

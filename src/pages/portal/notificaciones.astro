---
// Portal - Bandeja de notificaciones
// ------------
// Al abrir la bandeja se marcan como leídas: es el gesto que confirma que la
// persona ya las vio, y evita un botón extra que nadie usaría.

export const prerender = false

import LayoutPortal from '../../layouts/LayoutPortal.astro'
import { fechaHora, tiempoRelativo } from '../../lib/formato'

const { supabase, perfil } = Astro.locals

const { data: notificaciones } = await supabase
	.from('notificaciones')
	.select('*')
	.eq('perfil_id', perfil!.id)
	.order('creado_en', { ascending: false })
	.limit(50)

const sinLeer = (notificaciones ?? []).filter((n) => !n.leida).map((n) => n.id)

if (sinLeer.length > 0) {
	await supabase
		.from('notificaciones')
		.update({ leida: true, leida_en: new Date().toISOString() })
		.in('id', sinLeer)
}

const ICONO: Record<string, string> = {
	exito: 'bg-campo-100 text-campo-700',
	alerta: 'bg-oro-100 text-oro-800',
	error: 'bg-red-100 text-red-700',
	info: 'bg-primary-100 text-primary-700'
}
---

<LayoutPortal title="Notificaciones | Cooperativa Impulsa" activo="inicio">
	<h1 class="h2 mb-2">Notificaciones</h1>
	<p class="mb-8 text-neutral-500 dark:text-neutral-400">
		Avisos sobre tus trámites, pagos y créditos.
	</p>

	{
		notificaciones && notificaciones.length > 0 ? (
			<ul class="space-y-3">
				{notificaciones.map((n) => (
					<li
						class:list={[
							'panel flex gap-4',
							!n.leida && 'border-primary-300! dark:border-primary-700!'
						]}
					>
						<span
							class:list={[
								'flex size-9 shrink-0 items-center justify-center rounded-full text-sm font-bold',
								ICONO[n.tipo] ?? ICONO.info
							]}
							aria-hidden="true"
						>
							{n.tipo === 'exito' ? '✓' : n.tipo === 'error' ? '!' : 'i'}
						</span>

						<div class="min-w-0 flex-1">
							<div class="mb-1 flex flex-wrap items-baseline justify-between gap-2">
								<h2 class="mb-0 text-base">{n.titulo}</h2>
								<time
									class="text-xs text-neutral-500 dark:text-neutral-400"
									datetime={n.creado_en}
									title={fechaHora(n.creado_en)}
								>
									{tiempoRelativo(n.creado_en)}
								</time>
							</div>
							<p class="mb-0 text-sm">{n.mensaje}</p>
							{n.enlace && (
								<p class="mt-2 mb-0 text-sm">
									<a href={n.enlace}>Ver detalle →</a>
								</p>
							)}
						</div>
					</li>
				))}
			</ul>
		) : (
			<div class="panel py-12 text-center">
				<p class="mb-0 text-neutral-500 dark:text-neutral-400">
					No tienes notificaciones por ahora.
				</p>
			</div>
		)
	}
</LayoutPortal>

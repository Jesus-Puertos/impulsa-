---
// Portal - Solicitudes de crédito del socio
export const prerender = false

import LayoutPortal from '../../../layouts/LayoutPortal.astro'
import { pesos, fecha, ETIQUETAS_ESTADO_SOLICITUD } from '../../../lib/formato'
import { ETIQUETAS_PERIODO } from '../../../lib/credito'

const { supabase, perfil } = Astro.locals
const socioId = perfil!.socio_id
if (!socioId) return Astro.redirect('/registro')

const { data: solicitudes } = await supabase
	.from('solicitudes_credito')
	.select('*, productos_credito(nombre, clave)')
	.eq('socio_id', socioId)
	.order('creado_en', { ascending: false })

const puedeSolicitar = perfil!.socio_estado === 'activo'
---

<LayoutPortal title="Mis solicitudes | Cooperativa Impulsa" activo="solicitudes">
	<div class="mb-8 flex flex-wrap items-center justify-between gap-4">
		<h1 class="h2 mb-0">Mis solicitudes</h1>
		{
			puedeSolicitar && (
				<a href="/portal/solicitudes/nueva" class="btn btn--primario">
					Nueva solicitud
				</a>
			)
		}
	</div>

	{
		!puedeSolicitar && (
			<div class="aviso aviso--alerta">
				<p>
					{perfil!.socio_estado === 'en_revision'
						? 'Tu expediente está en revisión. En cuanto se apruebe podrás solicitar créditos.'
						: 'Necesitas completar y que se apruebe tu expediente para solicitar crédito.'}
					{perfil!.socio_estado === 'prospecto' && (
						<>
							{' '}
							<a href="/registro">Termina tu registro</a>.
						</>
					)}
				</p>
			</div>
		)
	}

	{
		solicitudes && solicitudes.length > 0 ? (
			<div class="space-y-4">
				{solicitudes.map((s) => (
					<article class="panel">
						<div class="flex flex-wrap items-start justify-between gap-4">
							<div class="min-w-64 flex-1">
								<div class="mb-1 flex flex-wrap items-center gap-3">
									<h2 class="mb-0 text-lg">
										{(s.productos_credito as { nombre: string } | null)?.nombre ?? 'Crédito'}
									</h2>
									<span class={`estado estado--${s.estado}`}>
										{ETIQUETAS_ESTADO_SOLICITUD[s.estado]}
									</span>
								</div>
								<p class="mb-3 text-xs text-neutral-500 dark:text-neutral-400">
									{s.folio ?? 'Sin folio'} · Enviada el {fecha(s.fecha_envio ?? s.creado_en)}
								</p>

								<dl class="grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
									<div>
										<dt class="text-xs text-neutral-500 dark:text-neutral-400">Solicitaste</dt>
										<dd class="font-medium tabular-nums">{pesos(s.monto_solicitado)}</dd>
									</div>
									<div>
										<dt class="text-xs text-neutral-500 dark:text-neutral-400">Plazo</dt>
										<dd class="tabular-nums">
											{s.plazo_periodos} {ETIQUETAS_PERIODO[s.periodicidad]}
										</dd>
									</div>
									<div>
										<dt class="text-xs text-neutral-500 dark:text-neutral-400">Destino</dt>
										<dd>{s.destino}</dd>
									</div>
									{s.monto_aprobado && (
										<div>
											<dt class="text-xs text-neutral-500 dark:text-neutral-400">Autorizado</dt>
											<dd class="text-campo-700 dark:text-campo-300 font-medium tabular-nums">
												{pesos(s.monto_aprobado)}
											</dd>
										</div>
									)}
								</dl>
							</div>
						</div>

						{s.estado === 'rechazada' && s.motivo_rechazo && (
							<div class="aviso aviso--error mt-4 mb-0">
								<p>
									<strong>Motivo:</strong> {s.motivo_rechazo}
								</p>
							</div>
						)}

						{s.estado === 'aprobada' && (
							<div class="aviso aviso--exito mt-4 mb-0">
								<p>
									Tu solicitud fue autorizada por {pesos(s.monto_aprobado ?? 0)}. Acude a tu
									sucursal a firmar el contrato para recibir el desembolso.
								</p>
							</div>
						)}

						{['enviada', 'en_revision'].includes(s.estado) && (
							<p class="small mt-4 mb-0">
								En revisión desde el {fecha(s.fecha_envio ?? s.creado_en)}. El dictamen suele
								tardar de 3 a 5 días hábiles.
							</p>
						)}

						{s.comentarios_analista && (
							<p class="small mt-3 mb-0">
								<strong>Nota del analista:</strong> {s.comentarios_analista}
							</p>
						)}
					</article>
				))}
			</div>
		) : (
			<div class="panel py-12 text-center">
				<h2 class="h4">Todavía no has solicitado crédito</h2>
				<p class="text-neutral-500 dark:text-neutral-400">
					Empieza por simular cuánto necesitas y en cuánto tiempo lo pagarías.
				</p>
				<a href="/simulador" class="btn btn--primario">
					Ir al simulador
				</a>
			</div>
		)
	}
</LayoutPortal>

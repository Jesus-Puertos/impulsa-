# =============================================================================
# Cooperativa Impulsa - Variables de entorno
# =============================================================================
# Copia este archivo como `.env` y rellena los valores de tu proyecto Supabase.
# Panel: https://supabase.com/dashboard/project/_/settings/api
#
# NUNCA subas el archivo `.env` al repositorio (ya esta en .gitignore).
# -----------------------------------------------------------------------------

# --- Supabase: valores publicos (viajan al navegador) ------------------------
# El prefijo PUBLIC_ es obligatorio en Astro para exponerlos al cliente.
PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...."

# --- Supabase: valor privado (SOLO servidor) ---------------------------------
# Ignora las politicas RLS. Se usa unicamente en endpoints del servidor para
# tareas administrativas (alta de personal, generacion de tablas de
# amortizacion, firmado de URLs de documentos KYC).
# Si esta clave se filtra, cualquiera puede leer y escribir toda la base.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...."

# --- Aplicacion --------------------------------------------------------------
# URL publica del sitio, usada para los enlaces de correo de Supabase Auth.
PUBLIC_SITE_URL="http://localhost:4321"

# Correo de la primera cuenta administradora. El seed le asigna el rol
# `admin` automaticamente tras registrarse.
ADMIN_BOOTSTRAP_EMAIL="direccion@cooperativaimpulsa.mx"
